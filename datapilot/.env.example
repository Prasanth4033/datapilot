# Copy to .env and fill in. .env is never committed.
LLM_PROVIDER=openai          # openai | fake  (fake needs no key, for tests)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-key-here
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4
LLM_RPM_LIMIT=60             # set a little below your account's real limit
LLM_TPM_LIMIT=60000
DOMAIN=lending
DATABASE_URL=sqlite:///datapilot.db   # later: postgresql+psycopg://user:pass@localhost:5432/datapilot
